    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1" />
    <PackageVersion Include="Hexa.NET.GLFW" Version="1.0.5" />
    <PackageVersion Include="Hexa.NET.ImGui" Version="2.2.9" />
    <PackageVersion Include="Hexa.NET.ImGui.Backends" Version="1.0.18" />
    <PackageVersion Include="Hexa.NET.ImGui.Backends.GLFW" Version="1.0.18" />
    <PackageVersion Include="Hexa.NET.ImPlot" Version="2.2.9" />
    <PackageVersion Include="Hexa.NET.OpenGL3" Version="1.1.0" />
    <PackageVersion Include="Hexa.NET.SDL3" Version="1.2.17" />
    <PackageVersion Include="Huskui.Avalonia" Version="1.1.3" />
    <PackageVersion Include="Huskui.Avalonia.Markdown" Version="1.1.3" />
    <PackageVersion Include="Microsoft.Extensions.FileSystemGlobbing" Version="9.0.10" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Mono.Options" Version="6.12.0.148" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="OpenTelemetry" Version="1.16.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.16.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.16.0" />
    <PackageVersion Include="Optris.Icons.Avalonia" Version="12.0.6" />
    <PackageVersion Include="Optris.Icons.Avalonia.FontAwesome" Version="12.0.6" />
    <PackageVersion Include="Optris.Icons.Avalonia.MaterialDesign" Version="12.0.6" />
    <PackageVersion Include="RBush" Version="4.0.0" />
    <PackageVersion Include="SharpDX" Version="4.2.0" />

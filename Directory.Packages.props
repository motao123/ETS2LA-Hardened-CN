<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally Condition="$([System.String]::Copy('$(MSBuildProjectDirectory)').Contains('\TruckLib\')) != 'True'">true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Condition="'$(ManagePackageVersionsCentrally)' == 'true'">
    <PackageVersion Include="AsyncImageLoader.Avalonia" Version="3.8.0" />

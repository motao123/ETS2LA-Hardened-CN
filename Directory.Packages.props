    <PackageVersion Include="SharpHook" Version="7.1.1" />
    <PackageVersion Include="SoundFlow" Version="1.4.0" />
    <PackageVersion Include="SoundFlow.Codecs.FFMpeg" Version="1.4.0" />
    <PackageVersion Include="Spectre.Console" Version="0.54.0" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <PackageVersion Include="System.Drawing.Common" Version="7.0.0" />
    <PackageVersion Include="TruckLib.HashFs" Version="0.1.18" />
    <PackageVersion Include="TruckLib.Sii" Version="0.1.13" />
    <PackageVersion Include="Velopack" Version="0.0.1298" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hexa.NET.GLFW" />
    <PackageReference Include="Hexa.NET.ImGui"  />
    <PackageReference Include="Hexa.NET.ImPlot"  />
    <PackageReference Include="Hexa.NET.ImGui.Backends"  />
    <PackageReference Include="Hexa.NET.ImGui.Backends.GLFW"  />
    <PackageReference Include="Hexa.NET.OpenGL3"  />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ETS2LA.Logging\ETS2LA.Logging.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\ETS2LA.Shared\ETS2LA.Shared.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\ETS2LA.Controls\ETS2LA.Controls.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\ETS2LA.State\ETS2LA.State.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\ETS2LA.Telemetry\ETS2LA.Telemetry.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\ETS2LA.Game\ETS2LA.Game.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="..\ETS2LA.ML\ETS2LA.ML.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(OS)' == 'Unix'">
    <DefineConstants>$(DefineConstants);LINUX</DefineConstants>
  </PropertyGroup>
</Project>

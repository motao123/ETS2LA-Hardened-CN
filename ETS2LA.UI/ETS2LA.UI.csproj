<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AsyncImageLoader.Avalonia"  />
    <PackageReference Include="Avalonia" >
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Avalonia.Desktop" >
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Avalonia.Themes.Fluent" >
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport"  Condition="'$(Configuration)'=='Debug'">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Avalonia.ReactiveUI" >
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Avalonia.Controls.DataGrid" >
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Huskui.Avalonia" >
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Huskui.Avalonia.Markdown" >
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Optris.Icons.Avalonia" >
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Optris.Icons.Avalonia.FontAwesome" >
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Optris.Icons.Avalonia.MaterialDesign" >
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <Compile Remove="Views/VisualizationView.axaml.cs" />
    <AvaloniaXaml Remove="Views/VisualizationView.axaml" />
  </ItemGroup>

  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(OS)' == 'Unix'">
    <DefineConstants>$(DefineConstants);LINUX</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup Label="ProjectReferences">
    <ProjectReference Include="..\ETS2LA.Backend\ETS2LA.Backend.csproj" />
    <ProjectReference Include="..\ETS2LA.Shared\ETS2LA.Shared.csproj" />
    <ProjectReference Include="..\ETS2LA.Logging\ETS2LA.Logging.csproj" />
    <ProjectReference Include="..\ETS2LA.Audio\ETS2LA.Audio.csproj" />
    <ProjectReference Include="..\ETS2LA.Notifications\ETS2LA.Notifications.csproj" />
    <ProjectReference Include="..\ETS2LA.Game\ETS2LA.Game.csproj" />
    <ProjectReference Include="..\ETS2LA.State\ETS2LA.State.csproj" />
    <ProjectReference Include="..\ETS2LA.Overlay\ETS2LA.Overlay.csproj" />
    <ProjectReference Include="..\ETS2LA.Networking\ETS2LA.Networking.csproj" />
  </ItemGroup>
</Project>

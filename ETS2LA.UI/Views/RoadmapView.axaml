<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ETS2LA.UI.Views"
             x:Class="ETS2LA.UI.Views.RoadmapView">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20">
        <StackPanel Spacing="14">
            <TextBlock Text="路线图" FontSize="20" FontWeight="SemiBold" />

            <Border Padding="16" CornerRadius="8" Background="{DynamicResource Gray3Color}">
                <StackPanel Spacing="8">
                    <TextBlock Text="已完成" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="• P0 — 插件供应链与下载解压安全加固" Classes="Description" />
                    <TextBlock Text="• P0 — 控制输出失效安全（权重融合与中性值回退）" Classes="Description" />
                    <TextBlock Text="• P1 — 配置路径校验、JWT 凭据保护与原子保存" Classes="Description" />
                    <TextBlock Text="• P2 — 完整中英文界面与本地化切换" Classes="Description" />
                    <TextBlock Text="• 游戏遥测连接与性能监控面板" Classes="Description" />
                </StackPanel>
            </Border>

            <Border Padding="16" CornerRadius="8" Background="{DynamicResource Gray3Color}">
                <StackPanel Spacing="8">
                    <TextBlock Text="规划中" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="• 游戏地图可视化渲染" Classes="Description" />
                    <TextBlock Text="• GitHub 自动更新与安装包发布" Classes="Description" />
                    <TextBlock Text="• 更多驾驶辅助功能与插件生态" Classes="Description" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="GitHub 仓库" Click="OpenGitHub" />
                <Button Content="原作者项目" Click="OpenOriginalProject" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ETS2LA.UI.Views.Settings"
             xmlns:husk="https://github.com/d3ara1n/Huskui.Avalonia"
             x:Class="ETS2LA.UI.Views.Settings.AssistanceSettingsPage"
             x:DataType="views:AssistanceSettingsPage">
    <StackPanel>
        <Grid ColumnDefinitions="450,*">
        <StackPanel Grid.Column="0" Spacing="20" Margin="20">

            <!--
            <StackPanel Spacing="10" Tapped="OnSeparateCruiseAndSteeringClicked">
                <StackPanel Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <husk:Tag IsVisible="{Binding SeparateCruiseAndSteering}" Classes="Primary" Width="35">
                            <TextBlock Text="开" Classes="Highlight" HorizontalAlignment="Center" />
                        </husk:Tag>
                        <husk:Tag IsVisible="{Binding !SeparateCruiseAndSteering}" Classes="Secondary" Width="35">
                            <TextBlock Text="关" Classes="Description" HorizontalAlignment="Center" />
                        </husk:Tag>
                        <TextBlock Text="分离巡航与转向" />
                    </StackPanel>
                    <TextBlock Text="是否分离巡航控制和转向。分离后，单击将触发巡航，双击将同时启用两者。" FontSize="12" Classes="Description" />
                </StackPanel>
            </StackPanel>
            -->

            <StackPanel Spacing="10">
                <StackPanel Spacing="3">
                    <TextBlock Text="SET 行为" />
                    <TextBlock Text="按下 SET 按钮时，ETS2LA 应将当前巡航控制速度设置为什么？" FontSize="12" Classes="Description" />
                </StackPanel>
                <TabStrip ItemsSource="{Binding SetSpeedBehaviourOptions}" 
                        SelectedIndex="{Binding SelectedSetSpeedBehaviourOption}" 
                        SelectionChanged="OnSetSpeedBehaviourChanged"
                        AutomationProperties.Name="SET 按键行为">

                    <TabStrip.Styles>
                        <Style Selector="TabStripItem" x:DataType="views:TabStripItemHandler">
                            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                        </Style>
                    </TabStrip.Styles>

                    <TabStrip.ItemTemplate>
                        <DataTemplate x:DataType="views:TabStripItemHandler">
                            <Border Width="115" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center" AutomationProperties.Name="{Binding AutomationName}">
                                <TextBlock Text="{Binding Header}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                        </DataTemplate>
                    </TabStrip.ItemTemplate>
                </TabStrip>
            </StackPanel>

            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Text="{Binding SnapTo10UnitsDisplay}" VerticalAlignment="Center" />
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding SnapTo10Units}" Classes="primary-toggle" AutomationProperties.Name="将 ACC 吸附到 10 个单位" />
                </Grid>
                <TextBlock Text="更改速度时吸附到最接近的 10 个单位，例如 37 -> 39 -> 40 -> 42……" FontSize="12" Classes="Description" />
            </StackPanel>

            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="速度控制步长" />
                    <TextBlock Text="{Binding SpeedControlDisplay}" />
                </StackPanel>
                <Slider Name="SpeedControlStepSizeSlider" Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding SpeedControlStepSize}" AutomationProperties.Name="ACC 速度控制步长" />
            </StackPanel>

            <Separator />

            <StackPanel Spacing="10">
                <StackPanel Spacing="3">
                    <TextBlock Text="转向响应" />
                    <TextBlock Text="调整 ETS2LA 对必要转向变化的响应方式，例如控制变道速度。" FontSize="12" Classes="Description" />
                </StackPanel>
                <TabStrip ItemsSource="{Binding SteeringSensitivityOptions}" 
                        SelectedIndex="{Binding SelectedSteeringSensitivityOption}" 
                        SelectionChanged="OnSteeringSensitivityChanged"
                        AutomationProperties.Name="转向响应">

                    <TabStrip.Styles>
                        <Style Selector="TabStripItem" x:DataType="views:TabStripItemHandler">
                            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                        </Style>
                    </TabStrip.Styles>

                    <TabStrip.ItemTemplate>
                        <DataTemplate x:DataType="views:TabStripItemHandler">
                            <Border Width="70" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center" AutomationProperties.Name="{Binding AutomationName}">
                                <TextBlock Text="{Binding Header}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                        </DataTemplate>
                    </TabStrip.ItemTemplate>
                </TabStrip>
            </StackPanel>
            
            <StackPanel Spacing="10">
                <StackPanel Spacing="3">
                    <TextBlock Text="加速响应" />
                    <TextBlock Text="调整 ETS2LA 对期望加速度变化的响应速度。紧急制动不受影响。" FontSize="12" Classes="Description" />
                </StackPanel>
                <TabStrip ItemsSource="{Binding AccelerationOptions}" 
                        SelectedIndex="{Binding SelectedAccelerationOption}"
                        SelectionChanged="OnAccelerationOptionChanged"
                        AutomationProperties.Name="加速响应">

                    <TabStrip.Styles>
                        <Style Selector="TabStripItem" x:DataType="views:TabStripItemHandler">
                            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                        </Style>
                    </TabStrip.Styles>

                    <TabStrip.ItemTemplate>
                        <DataTemplate x:DataType="views:TabStripItemHandler">
                            <Border Width="70" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center" AutomationProperties.Name="{Binding AutomationName}">
                                <TextBlock Text="{Binding Header}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                        </DataTemplate>
                    </TabStrip.ItemTemplate>
                </TabStrip>
            </StackPanel>

            <StackPanel Spacing="10">
                <StackPanel Spacing="3">
                    <TextBlock Text="跟车距离" />
                    <TextBlock Text="使用自适应巡航控制时，调整 ETS2LA 尝试与前车保持的距离。" FontSize="12" Classes="Description" />
                </StackPanel>
                <TabStrip ItemsSource="{Binding FollowingDistanceOptions}" 
                        SelectedIndex="{Binding SelectedFollowingDistanceOption}" 
                        SelectionChanged="OnFollowingDistanceChanged"
                        AutomationProperties.Name="跟车距离">

                    <TabStrip.Styles>
                        <Style Selector="TabStripItem" x:DataType="views:TabStripItemHandler">
                            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                        </Style>
                    </TabStrip.Styles>

                    <TabStrip.ItemTemplate>
                        <DataTemplate x:DataType="views:TabStripItemHandler">
                            <Border Width="70" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center" AutomationProperties.Name="{Binding AutomationName}">
                                <TextBlock Text="{Binding Header}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                        </DataTemplate>
                    </TabStrip.ItemTemplate>
                </TabStrip>
            </StackPanel>

            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Text="忽略交通规则" VerticalAlignment="Center" />
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding IgnoreTrafficRules}" Classes="primary-toggle" AutomationProperties.Name="忽略交通规则" />
                </Grid>
                <TextBlock Text="我们将忽略交通规则和限速。请做好车辆及他人车辆受损的准备。为什么要启用此选项？" FontSize="12" Classes="Description" />
            </StackPanel>

            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="最高速度" />
                    <TextBlock Text="{Binding MaximumSpeedDisplay}" />
                </StackPanel>
                <Slider Name="MaximumSpeedSlider" Minimum="0" Maximum="120" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding MaximumSpeed}" AutomationProperties.Name="最高速度限制" />
            </StackPanel>

            <Separator />

            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Text="不稳定时暂停" VerticalAlignment="Center" />
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding PauseWhenUnstable}" Classes="primary-toggle" AutomationProperties.Name="不稳定时暂停" />
                </Grid>
                <TextBlock Text="检测到不稳定，或转向无响应/自行禁用时，我们将暂停游戏。" FontSize="12" Classes="Description" />
            </StackPanel>

            <Separator />

            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Text="辅助自动激活" VerticalAlignment="Center" />
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoEngageAssists}" Classes="primary-toggle" AutomationProperties.Name="辅助自动激活" />
                </Grid>
                <TextBlock Text="检测到游戏连接后自动激活辅助，无需手动按 SET。" FontSize="12" Classes="Description" />
            </StackPanel>

            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Text="接管后自动恢复" VerticalAlignment="Center" />
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoResumeAfterIntervention}" Classes="primary-toggle" AutomationProperties.Name="接管后自动恢复" />
                </Grid>
                <TextBlock Text="驾驶员接管、松开输入数秒后自动恢复辅助（车辆停止时不会自动起步）。" FontSize="12" Classes="Description" />
            </StackPanel>

            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Text="启动自动启用插件" VerticalAlignment="Center" />
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoEnablePlugins}" Classes="primary-toggle" AutomationProperties.Name="启动自动启用插件" />
                </Grid>
                <TextBlock Text="启动时自动启用所有已加载的插件，无需逐个手动开启。" FontSize="12" Classes="Description" />
            </StackPanel>

            <StackPanel Spacing="10">
                <StackPanel Spacing="3">
                    <TextBlock Text="限速警告" />
                    <TextBlock Text="ETS2LA 应如何提醒限速？" FontSize="12" Classes="Description" />
                </StackPanel>
                <TabStrip ItemsSource="{Binding SpeedLimitWarningOptions}" 
                        SelectedIndex="{Binding SelectedSpeedLimitWarningOption}"
                        SelectionChanged="OnSpeedLimitWarningChanged"
                        AutomationProperties.Name="限速警告样式">

                    <TabStrip.Styles>
                        <Style Selector="TabStripItem" x:DataType="views:TabStripItemHandler">
                            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                        </Style>
                    </TabStrip.Styles>

                    <TabStrip.ItemTemplate>
                        <DataTemplate x:DataType="views:TabStripItemHandler">
                            <Border Width="70" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center" AutomationProperties.Name="{Binding AutomationName}">
                                <TextBlock Text="{Binding Header}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                        </DataTemplate>
                    </TabStrip.ItemTemplate>
                </TabStrip>
            </StackPanel>

            <StackPanel Spacing="10">
                <StackPanel Spacing="3">
                    <TextBlock Text="碰撞规避" />
                    <TextBlock Text="ETS2LA 应在何时介入以避免碰撞？" FontSize="12" Classes="Description" />
                </StackPanel>
                <TabStrip ItemsSource="{Binding CollisionAvoidanceOptions}" 
                        SelectedIndex="{Binding SelectedCollisionAvoidanceOption}" 
                        SelectionChanged="OnCollisionAvoidanceChanged"
                        AutomationProperties.Name="碰撞规避距离">

                    <TabStrip.Styles>
                        <Style Selector="TabStripItem" x:DataType="views:TabStripItemHandler">
                            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                        </Style>
                    </TabStrip.Styles>

                    <TabStrip.ItemTemplate>
                        <DataTemplate x:DataType="views:TabStripItemHandler">
                            <Border Width="70" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center" AutomationProperties.Name="{Binding AutomationName}">
                                <TextBlock Text="{Binding Header}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                        </DataTemplate>
                    </TabStrip.ItemTemplate>
                </TabStrip>
            </StackPanel>
        </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ETS2LA.UI.Views.Settings"
             x:Class="ETS2LA.UI.Views.Settings.ExperimentsSettings"
             x:DataType="views:ExperimentsSettings">
    <Grid ColumnDefinitions="450,*">
        <StackPanel Grid.Column="0" Spacing="12" Margin="20">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Text="渲染视觉摄像头" VerticalAlignment="Center" />
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding RenderVisionCameras}" Classes="primary-toggle" AutomationProperties.Name="渲染视觉摄像头" />
                </Grid>
                <TextBlock Text="渲染实验性视觉摄像头。这些摄像头可供基于视觉的机器学习模型用于端到端自动驾驶。请注意，这些模型目前尚不存在，但出于开发目的，我们保留了摄像头访问能力。" FontSize="12" Classes="Description" />
                <TextBlock Text="需要重启 ETS2LA 才能应用此选项。" FontSize="12" Classes="Warning" IsVisible="{Binding RenderVisionCamerasRequiresRestart}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>